{
  "description": "CSpell configuration for Custom Formatters module. Aligned with Drupal.org GitLab CI defaults.",
  "language": "en-US",
  "allowCompoundWords": false,
  "globRoot": ".",
  "minWordLength": 4,
  "ignorePaths": [
    "build",
    "vendor",
    "node_modules",
    ".git",
    "*.patch",
    "*.svg",
    "*.min.js",
    "*.min.css"
  ],
