##
# Configuration file for PHPStan static code checking, see https://phpstan.org .
#
# Note that drupal-specific rules are automatically included by phpstan/extension-installer
# from vendor/mglaman/phpstan-drupal/extension.neon and vendor/mglaman/phpstan-drupal/rules.neon
# @see https://github.com/mglaman/phpstan-drupal
#
# Paths are passed as CLI arguments.

parameters:

  level: 7

  paths:
    - web/modules/custom
    - web/themes/custom

  excludePaths:
    - vendor/*
    - node_modules/*
    - ../*/node_modules/*
    - rector.php
    - "*/sites/default/files/*"

  ignoreErrors:
    -
      # Hook implementations do not provide docblocks for parameters, so there
      # is no way to provide this information.
      messages:
        - '#.* no value type specified in iterable type array#'
        - '#.* has no return type specified#'
      reportUnmatched: false

    -
      # Unsafe usage of new static() - Drupal core pattern for Controllers, Forms, ListBuilders, Derivers
      messages:
        - '#Unsafe usage of new static#'
      reportUnmatched: false

    -
      # TranslatableMarkup vs string return type mismatch - Drupal core pattern
      messages:
        - '#should return string but returns.*TranslatableMarkup#'
      reportUnmatched: false

    -
      # Generic type issues with FieldItemListInterface - Drupal core pattern
      messages:
        - '#no value type specified in iterable type.*FieldItemListInterface#'
      reportUnmatched: false

    -
      # treatPhpDocTypesAsCertain warnings
      messages:
        - '#Because the type is coming from a PHPDoc#'
      reportUnmatched: false

    -
      # Generic type issues with FormatterInterface and EntityReferenceFormatterBase
      messages:
        - '#does not specify its types: T#'
      reportUnmatched: false

    -
      # call_user_func_array - dynamic method invocation with runtime-resolved method names
      messages:
        - '#Parameter .1 \$callback of function call_user_func_array#'
      reportUnmatched: false

    -
      # no value type specified in iterable type Traversable - Drupal core pattern
      messages:
        - '#no value type specified in iterable type Traversable#'
      reportUnmatched: false

    -
      # no value type specified in iterable type FieldItemListInterface - Drupal core pattern
      messages:
        - '#no value type specified in iterable type.*FieldItemListInterface#'
      reportUnmatched: false

    -
      # Call to an undefined method on EntityInterface - test pattern
      messages:
        - '#Call to an undefined method.*EntityInterface#'
      reportUnmatched: false

    -
      # Generic type issues in viewElements - Drupal core pattern
      messages:
        - '#has parameter \$items with generic interface.*FieldItemListInterface but does not specify its types#'
      reportUnmatched: false

    -
      # DevelDumperManagerInterface — optional devel dependency
      messages:
        - '#has unknown class Drupal\\devel\\DevelDumperManagerInterface#'
        - '#has invalid type Drupal\\devel\\DevelDumperManagerInterface#'
        - '#Call to an undefined method.*DevelDumperManagerInterface#'
      reportUnmatched: false

    -
      # ConfigEntityListBuilder requires $storage in constructor via createInstance.
      # Scoped to FormatterListBuilder only.
      message: '#Direct injection of entity storage via \$storage is not recommended#'
      path: web/modules/custom/custom_formatters/src/FormatterListBuilder.php

    -
      # Deprecated in Drupal 11.4, removal in 12/13 — no replacement available yet
      messages:
        - '#Call to deprecated function node_access_rebuild\(\)#'
        - '#Call to deprecated function _contextual_links_to_id\(\)#'
      reportUnmatched: false

  reportUnmatchedIgnoredErrors: false
