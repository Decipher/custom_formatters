<?php

/**
 * @file
 * Install functions for the Custom Formatters module.
 */

declare(strict_types=1);

/**
 * Implements hook_install().
 */
function custom_formatters_install(): void {
  $update_manager = \Drupal::entityDefinitionUpdateManager();

  // On newer Drupal versions entity types may be auto-installed before
  // hook_install() runs. Only install the schema if it isn't already present.
  if (!$update_manager->getEntityType('formatter_setting')) {
    $definition = \Drupal::entityTypeManager()->getDefinition('formatter_setting');
    $update_manager->installEntityType($definition);
  }

  \Drupal::service('plugin.manager.field.formatter')
    ->clearCachedDefinitions();
}

/**
 * Install the formatter_setting entity type for fieldable settings.
 */
function custom_formatters_update_8401(): void {
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  if (!$update_manager->getEntityType('formatter_setting')) {
    $definition = \Drupal::entityTypeManager()->getDefinition('formatter_setting');
    $update_manager->installEntityType($definition);
  }
}

/**
 * Retroactively installs the formatter_setting schema.
 *
 * For sites that ran the broken 8401 update and need to install the schema
 * that was never created.
 */
function custom_formatters_update_8402(): void {
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  if (!$update_manager->getEntityType('formatter_setting')) {
    $definition = \Drupal::entityTypeManager()->getDefinition('formatter_setting');
    $update_manager->installEntityType($definition);
  }
}
