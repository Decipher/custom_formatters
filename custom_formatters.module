<?php

/**
 * @file
 * Core functions for the Custom Formatters module.
 */

declare(strict_types=1);

use Drupal\Core\Link;
use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
function custom_formatters_help(string $route_name, RouteMatchInterface $route_match): ?string {
  switch ($route_name) {
    case 'help.page.custom_formatters':
      $output = '';
      $output .= '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('The Custom Formatters module allows users to easily create custom Field Formatters through an admin UI without writing a custom module. It supports multiple formatter engines: Formatter Preset, HTML+Token, PHP, and Twig.') . '</p>';

      $output .= '<h3>' . t('Uses') . '</h3>';
      $output .= '<dl>';
      $output .= '<dt>' . t('Formatter Preset') . '</dt>';
      $output .= '<dd>' . t('Build formatters from existing field formatters with preset settings.') . '</dd>';
      $output .= '<dt>' . t('HTML + Tokens') . '</dt>';
      $output .= '<dd>' . t('A HTML-based editor with Token support. When the Token module is installed, a token tree browser is available for inserting tokens. Entity reference fields automatically provide tokens for the referenced entity.') . '</dd>';
      $output .= '<dt>' . t('PHP') . '</dt>';
      $output .= '<dd>' . t('A PHP-based editor with support for multiple fields and values. Note: this engine uses eval() and access is restricted to users with the "administer custom formatters" permission.') . '</dd>';
      $output .= '<dt>' . t('Twig') . '</dt>';
      $output .= '<dd>' . t('A Twig-based editor with support for multiple fields and values.') . '</dd>';
      $output .= '</dl>';

      $output .= '<p>' . t('For more information, see the <a href=":handbook">Custom Formatters handbook page</a>.', [
        ':handbook' => 'https://www.drupal.org/node/2514412',
      ]) . '</p>';

      return $output;

    default:
      return NULL;
  }
}

/**
 * Implements hook_theme().
 */
function custom_formatters_theme() {
  $themes['formatter_add_list'] = [
    'variables' => ['content' => NULL],
  ];

  return $themes;
}

/**
 * Prepares variables for list of available formatter type templates.
 *
 * Default template: formatter-add-list.html.twig.
 *
 * @param array $variables
 *   An associative array containing:
 *   - content: An array of formatter types.
 */
function template_preprocess_formatter_add_list(&$variables) {
  $variables['types'] = [];
  if (!empty($variables['content'])) {
    foreach ($variables['content'] as $type) {
      $variables['types'][$type['id']] = [
        'type'        => $type['id'],
        'add_link'    => Link::createFromRoute($type['label'], 'custom_formatters.add', ['formatter_type' => $type['id']]),
        'description' => [
          '#markup' => $type['description'],
        ],
      ];
    }
  }
}
